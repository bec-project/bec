#!/usr/bin/env bash
set -euo pipefail

files=()
while IFS= read -r -d '' file; do
    files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.py' '*.pyi')

if [ "${#files[@]}" -eq 0 ]; then
    exit 0
fi

for file in "${files[@]}"; do
    git show ":$file" | ruff check --stdin-filename "$file" -
    git show ":$file" | ruff format --check --stdin-filename "$file" -
done
